# Public URL (canonical, hreflang, sitemap). No trailing slash.
NEXT_PUBLIC_SITE_URL=https://crownd.dev

# Database: local file in dev, Turso (libsql://...) in production.
DATABASE_URL=file:local.db
DATABASE_AUTH_TOKEN=

# Stripe. Leave empty to use the built-in demo checkout.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Outbid e-mails (optional). Without it, notifications are logged.
RESEND_API_KEY=
MAIL_FROM="Crownd <crown@crownd.dev>"

# Salt for hashing visitor fingerprints in click dedupe (never store raw IPs).
CLICK_SALT=change-me

# Legal entity shown on /{edition}/legal (Impressum, 特商法, etc.)
LEGAL_ENTITY=
LEGAL_ADDRESS=
LEGAL_TAX_ID=
LEGAL_EMAIL=

# Set to 0 to disable demo seed data in development.
SEED_DEMO=1

# Stripe Tax (1 = automatic tax, prices tax-inclusive). Set by: npm run stripe:setup
STRIPE_AUTOMATIC_TAX=0

# Search engine ownership verification (meta tags). Values come from each console.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
NEXT_PUBLIC_NAVER_SITE_VERIFICATION=
NEXT_PUBLIC_YANDEX_SITE_VERIFICATION=

# IndexNow (Bing, Yandex, Naver, Seznam): any 32+ hex chars, e.g. `openssl rand -hex 16`
INDEXNOW_KEY=
