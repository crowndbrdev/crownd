{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "crownd",
  "main": "worker.ts", // wraps .open-next/worker.js (HTTP → HTTPS 301)
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // html_handling "none": serve verification files (naver….html, yandex_….html) at their exact URL, no .html-stripping redirect.
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS", "html_handling": "none" },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "crownd" }],
  "observability": { "enabled": true },
  // Smart Placement runs the Worker close to D1 (fewer long round-trips for multi-query pages).
  "placement": { "mode": "smart" },

  // App database (Cloudflare D1 = SQLite at the edge). database_id is filled by `npm run launch`.
  "d1_databases": [
    { "binding": "DB", "database_name": "crownd-db", "database_id": "9af9df35-0cad-41d5-89f7-bd96c639c79e", "migrations_dir": "migrations" }
  ],

  // Native rate limiting (per client IP, enforced in src/lib/security.ts).
  "ratelimits": [
    { "name": "RL_WRITE", "namespace_id": "1001", "simple": { "limit": 12, "period": 60 } },
    { "name": "RL_TRACK", "namespace_id": "1002", "simple": { "limit": 120, "period": 60 } }
  ],

  // Public, non-secret config. Secrets (Stripe keys etc.) go in via `wrangler secret put`.
  "vars": { "NEXT_PUBLIC_SITE_URL": "https://crownd.dev" },

  // crownd.dev + www are attached as Custom Domains (Cloudflare issues the TLS certs).
  // Uncommented by `npm run launch` once the domain is on the account.
  "routes": [
    { "pattern": "crownd.dev", "custom_domain": true },
    { "pattern": "www.crownd.dev", "custom_domain": true }
  ]
}
